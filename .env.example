# Токен бота от @BotFather
BOT_TOKEN=

# Токен приложения из @CryptoBot -> Crypto Pay -> My Apps -> Create App
CRYPTO_PAY_TOKEN=

# ID приватного канала/группы, куда бот выдаёт доступ (число со знаком минус,
# например -1001234567890 — бот должен быть в нём админом)
CHANNEL_ID=

# Telegram id админов бота через запятую (свой узнать у @userinfobot)
ADMIN_IDS=

# Username бота без @ (для кнопки "открыть бота после оплаты")
BOT_USERNAME=

# Как называть канал в сообщениях пользователю
CHANNEL_TITLE=закрытый чат

# Цена подписки в USD (инвойс выставляется в фиате, оплата — в крипте по курсу)
SUBSCRIPTION_PRICE_USD=25

# Длительность подписки в днях
SUBSCRIPTION_DAYS=30

# Сколько дней после истечения ждать перед киком
GRACE_PERIOD_DAYS=2

# За сколько дней до окончания слать напоминание о продлении
REMINDER_DAYS_BEFORE=3

# Какие активы предлагать при оплате
ACCEPTED_ASSETS=USDT,TON,BTC

# Путь к файлу базы данных (на Railway должен быть внутри volume!)
DB_PATH=/data/subscriptions.db
